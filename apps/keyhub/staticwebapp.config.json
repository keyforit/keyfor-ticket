{
  "routes": [
    {
      "route": "/dashboard.html",
      "allowedRoles": ["utente"]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/403.html"
    }
  }
}
